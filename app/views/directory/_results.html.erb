<main class="px-6 py-12 lg:px-8 lg:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" aria-live="polite" aria-atomic="true">
      <div>
        <p class="font-semibold">
          <%= pluralize(@makers.size, "Maker") %>
        </p>
        <h2 class="mt-1 text-3xl font-bold tracking-tight">
          <% if @query.present? %>
            Results for “<%= @query %>”
          <% elsif @selected_tags.any? %>
            <%= @selected_tags.to_sentence %>
          <% else %>
            Meet the Makers
          <% end %>
        </h2>

        <% if @query.present? && @selected_tags.any? %>
          <p class="mt-1 text-sm text-muted-foreground">Filtered by <%= @selected_tags.to_sentence %></p>
        <% end %>
      </div>

      <% if @query.present? %>
        <%= link_to "Clear search",
                    root_path,
                    class: "btn-secondary",
                    data: { turbo_frame: "_top" } %>
      <% end %>
    </div>

    <% if @makers.any? %>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        <% @makers.each do |maker| %>
          <%= render "directory/maker", maker: maker %>
        <% end %>
      </div>
    <% else %>
      <div class="empty border-0 bg-card">
        <figure>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5M8.5 11h5"></path>
          </svg>
        </figure>
        <header>
          <h3>No makers found</h3>
          <p>Try a broader craft, place or category tag.</p>
        </header>
        <footer>
          <%= link_to "Show every maker", root_path, class: "btn", data: { turbo_frame: "_top" } %>
        </footer>
      </div>
    <% end %>
  </div>
</main>
