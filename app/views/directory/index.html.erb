<%# Title pattern mirrors midlandsmakers.co.uk's own ("Midlands Makers |
    Midlands Makers Markets") — "Directory" instead of "Markets" states
    clearly that this is the separate directory site. %>
<% content_for :title, @query.present? ? "Search results | Midlands Makers Directory" : "Midlands Makers | Midlands Makers Directory" %>

<%= render "directory/header" %>

<%= turbo_frame_tag "makers_results", class: "block" do %>
  <%= render "results" %>
<% end %>

<footer class="px-6 py-8 lg:px-8 flex justify-center items-center">
  <%= link_to root_path, class: "", aria: { label: "Midlands Makers home" } do %>
    <%= render "shared/logo", class: "h-24 shrink-0 transition-transform group-hover:-rotate-2" %>
  <% end %>
</footer>
