<article class="group flex min-h-full flex-col overflow-hidden rounded-2xl border bg-card shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
  <%= link_to maker.profile_url, target: "_blank", rel: "noopener", class: "block overflow-hidden bg-muted" do %>
    <% if maker.image.attached? %>
      <%# sharpen must nest inside the resize_to_fill array, not sit as its
          own top-level key — Active Storage drops any transformation whose
          value is falsy (ActiveStorage::Transformers::ImageProcessingTransformer
          #operations checks argument.present?), silently ignoring a bare
          `sharpen: false`. Needed because the default post-resize sharpen
          convolution interacts with these PNGs' (now-flattened, see
          db/seeds/makers.rb) source data to produce colour-fringe
          artifacts around edges. %>
      <%= image_tag maker.image.variant(resize_to_fill: [ 640, 480, { sharpen: false } ]),
        alt: "#{maker.name} — #{maker.tag_list.to_a.join(', ')}".delete_suffix(" — "),
        loading: "lazy",
        class: "aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-105" %>
    <% else %>
      <div class="flex aspect-[4/3] items-center justify-center bg-muted text-5xl font-semibold text-muted-foreground/40">
        <%= maker.name.first %>
      </div>
    <% end %>
  <% end %>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap gap-1.5">
      <% maker.tag_list.each do |tag| %>
        <span class="inline-flex rounded-full bg-orange/10 px-2 py-1 text-xs font-semibold text-orange">
          <%= tag %>
        </span>
      <% end %>
    </div>
    <h3 class="mt-2 text-xl font-semibold tracking-tight">
      <%= link_to maker.name, maker.profile_url, target: "_blank", rel: "noopener", class: "hover:text-primary" %>
    </h3>
    <p class="mt-3 flex-1 text-sm leading-6 text-muted-foreground"><%= maker.description %></p>

    <div class="mt-5 flex items-center justify-between gap-4 border-t pt-4">
      <%= link_to "Visit maker →", maker.profile_url, target: "_blank", rel: "noopener", class: "text-sm font-semibold text-primary hover:underline" %>

      <% if maker.website_url.present? || maker.instagram_url.present? %>
        <div class="flex items-center gap-2" aria-label="<%= maker.name %> links">
          <% if maker.website_url.present? %>
            <%= link_to maker.website_url,
              target: "_blank",
              rel: "noopener",
              class: "inline-flex size-9 items-center justify-center rounded-full border text-muted-foreground transition hover:border-orange hover:bg-orange hover:text-primary-foreground",
              aria: { label: "Visit #{maker.name} website" } do %>
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z"></path>
              </svg>
            <% end %>
          <% end %>

          <% if maker.instagram_url.present? %>
            <%= link_to maker.instagram_url,
              target: "_blank",
              rel: "noopener",
              class: "inline-flex size-9 items-center justify-center rounded-full border text-muted-foreground transition hover:border-orange hover:bg-orange hover:text-primary-foreground",
              aria: { label: "Follow #{maker.name} on Instagram" } do %>
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
              </svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
