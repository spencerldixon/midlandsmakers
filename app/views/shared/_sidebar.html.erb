<aside class="sidebar" data-side="left" aria-hidden="false">
  <nav aria-label="Sidebar navigation">
    <header>
      <%= link_to root_path, class: "p-2 text-2xl font-semibold" do %>
        Tinystarter<span class="text-violet-500 font-bold">.</span>
      <% end %>
    </header>

    <section class="scrollbar">
      <div role="group">
        <ul>
          <li>
            <%= link_to "#", class: "flex items-center gap-2 #{'bg-accent' if current_page?('#')}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <span>Search</span>
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "flex items-center gap-2 #{'bg-accent' if current_page?('#')}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
              <span>Reports</span>
            <% end %>
          </li>
        </ul>
      </div>
    </section>

    <section class="hidden">
      <div role="group" aria-labelledby="group-label-admin">
        <h3 id="group-label-admin">Admin</h3>
        <ul>
          <li>
            <%= link_to mission_control_jobs_path do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 11 2-2-2-2"/><path d="M11 13h4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/></svg>
              <span>Jobs</span>
            <% end %>
          </li>
        </ul>
      </div>
    </section>

    <footer>
      <%= link_to edit_user_registration_path, class: "btn-ghost p-2 h-12 w-full flex items-center justify-start" do %>
        <div class="grid flex-1 text-left text-sm leading-tight">
          <span class="truncate font-medium"><%= current_user.decorate.full_name %></span>
          <span class="truncate text-xs text-muted-foreground"><%= current_user.email %></span>
        </div>
      <% end %>
    </footer>
  </nav>
</aside>
