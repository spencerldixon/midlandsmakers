<%# Fields shared by the admin maker form (app/views/admin/makers/_form.html.erb)
    and the self-service profile form (app/views/profile/edit.html.erb).
    Expects `form` (a form_with builder) and `maker`. %>
<% if maker.errors.any? %>
  <div class="rounded-lg border border-destructive/40 bg-destructive/10 p-4 text-sm text-destructive">
    <p class="font-semibold"><%= pluralize(maker.errors.count, "error") %> stopped this from saving:</p>
    <ul class="mt-1 list-inside list-disc">
      <% maker.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="field">
  <%= form.label :name, class: "label" %>
  <%= form.text_field :name, required: true %>
</div>

<div class="field">
  <%= form.label :description, class: "label" %>
  <%= form.text_area :description, rows: 4, required: true, class: "textarea" %>
</div>

<div class="field">
  <%= form.label :tag_list, "Tags", class: "label" %>
  <% tag_options = (Array(@tag_options) | maker.tag_list.to_a).sort %>
  <%= form.select :tag_list, options_for_select(tag_options, maker.tag_list.to_a),
        {},
        multiple: true, data: { controller: "tags-select" } %>
  <p class="text-xs text-muted-foreground">Search existing crafts or type a new one and add it. Shown as the craft filters on the directory.</p>
</div>

<div class="field">
  <%= form.label :image, "Photo", class: "label" %>
  <% if maker.image.attached? %>
    <%= image_tag maker.image.variant(resize_to_fill: [ 160, 120, { sharpen: false } ]), class: "mb-2 rounded-lg border object-cover" %>
  <% end %>
  <%= form.file_field :image, accept: "image/*" %>
</div>

<div class="field">
  <%= form.label :website_url, "Website", class: "label" %>
  <%= form.url_field :website_url, placeholder: "https://…" %>
</div>

<div class="field">
  <%= form.label :instagram_url, "Instagram", class: "label" %>
  <%= form.url_field :instagram_url, placeholder: "https://instagram.com/…" %>
</div>
